generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users & Authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  username     String?   @unique
  bio          String?
  avatarUrl    String?
  timezone     String?
  language     String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  assignedIssues   Issue[]           @relation("Assignee")
  reportedIssues   Issue[]           @relation("Reporter")
  comments         Comment[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  activities       Activity[]
  notifications    Notification[]
  
  // New Relations for Feature Expansion
  invitationsSent  WorkspaceInvitation[] @relation("InvitationSender")
  teamMembers      TeamMember[]
  userRoles        UserRole[]
  sessions         Session[]
  workLogs         WorkLog[]
  watchers         IssueWatcher[]
  savedFilters     SavedFilter[]
  estimationVotes  EstimationVote[]
}

// Workspaces
model Workspace {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  // Relations
  members      WorkspaceMember[]
  projects     Project[]
  invitations  WorkspaceInvitation[]
  teams        Team[]
  roles        Role[]
  userRoles    UserRole[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    // "OWNER", "ADMIN", "MEMBER", "VIEWER"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// Teams
model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  workspaceId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// Workspace Invitations (GitHub-style Invite Flow)
model WorkspaceInvitation {
  id           String    @id @default(uuid())
  workspaceId  String
  invitedEmail String
  invitedBy    String
  role         String    // "ADMIN", "MEMBER", "VIEWER"
  token        String    @unique
  status       String    @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "EXPIRED", "CANCELLED"
  expiresAt    DateTime
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  archivedAt   DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender       User      @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)
}

// Roles & Permissions RBAC
model Role {
  id          String       @id @default(uuid())
  name        String       // e.g. "Workspace Admin", "Project Editor"
  description String?
  workspaceId String?      // null for default/system roles, or linked to workspace
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. "WORKSPACE_EDIT", "PROJECT_DELETE", "ISSUE_CREATE"
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id          String     @id @default(uuid())
  userId      String
  roleId      String
  workspaceId String
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, workspaceId])
}

// Session Tracking for Security
model Session {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  deviceInfo  String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  deletedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Projects
model Project {
  id          String    @id @default(uuid())
  name        String
  key         String // e.g. "PROJ"
  description String?
  icon        String?
  visibility  String    @default("PUBLIC") // "PUBLIC", "PRIVATE"
  workspaceId String
  leadId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  // Relations
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  boards      Board[]
  issues      Issue[]
  sprints     Sprint[]
  mappings    ImportMapping[]
  labels      Label[]
  statuses    Status[]
  releases    Release[]
  automationRules AutomationRule[]
  issueTemplates  IssueTemplate[]
  savedFilters    SavedFilter[]

  @@unique([workspaceId, key])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   // "ADMIN", "MEMBER", "VIEWER"
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Sprints & Boards
model Sprint {
  id        String    @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("FUTURE") // "ACTIVE", "FUTURE", "COMPLETED"
  projectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  archivedAt DateTime?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  estimationSessions EstimationSession[]
}

model Board {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("KANBAN") // "KANBAN", "SCRUM"
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  archivedAt DateTime?

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
}

model BoardColumn {
  id        String   @id @default(uuid())
  name      String
  position  Int      // Ordinal position
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  archivedAt DateTime?

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  issues    Issue[]
}

// Project Labels (Custom Issue Tags)
model Label {
  id          String       @id @default(uuid())
  name        String
  color       String       // e.g. "#FF0000"
  projectId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      IssueLabel[]
}

model IssueLabel {
  id        String   @id @default(uuid())
  issueId   String
  labelId   String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

// Project Workflow Custom Statuses
model Status {
  id          String       @id @default(uuid())
  name        String
  color       String
  projectId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Issues (Tasks, Bugs, etc.)
model Issue {
  id           String    @id @default(uuid())
  key          String    @unique // e.g. "PROJ-42"
  summary      String
  description  String?   // TipTap HTML/JSON content
  statusId     String    // Mapped to BoardColumn
  priority     String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "HIGHEST"
  type         String    @default("TASK")   // "STORY", "TASK", "BUG", "EPIC"
  storyPoints  Float?
  dueDate      DateTime?
  
  projectId    String
  sprintId     String?
  assigneeId   String?
  reporterId   String
  parentId     String?   // For Subtasks support
  epicId       String?   // Epic issue relation ID
  order        Float     @default(1000.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  archivedAt   DateTime?

  // Relations
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       BoardColumn    @relation(fields: [statusId], references: [id])
  sprint       Sprint?        @relation(fields: [sprintId], references: [id])
  assignee     User?          @relation("Assignee", fields: [assigneeId], references: [id])
  reporter     User           @relation("Reporter", fields: [reporterId], references: [id])
  parent       Issue?         @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Issue[]        @relation("Subtasks")
  
  comments     Comment[]
  attachments  Attachment[]
  activities   Activity[]
  customFields IssueCustomField[]
  labels       IssueLabel[]
  // Issue linking (blocks / is blocked by / relates to)
  outwardLinks IssueLink[] @relation("OutwardLinks")
  inwardLinks  IssueLink[] @relation("InwardLinks")
  workLogs     WorkLog[]
  watchers     IssueWatcher[]

  @@index([statusId, order])
}

// Issue Links (blocking, relating, duplicating)
model IssueLink {
  id           String   @id @default(uuid())
  linkType     String   // "BLOCKS", "IS_BLOCKED_BY", "RELATES_TO", "DUPLICATES", "IS_DUPLICATED_BY"
  sourceId     String   // The issue that has this link outward
  targetId     String   // The linked issue
  createdAt    DateTime @default(now())

  source       Issue    @relation("OutwardLinks", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Issue    @relation("InwardLinks", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, linkType])
  @@index([sourceId])
  @@index([targetId])
}

model IssueCustomField {
  id         String   @id @default(uuid())
  issueId    String
  fieldName  String
  fieldValue String   // JSON serialized value for flexible storage
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, fieldName])
}

// Comments, Attachments, Notifications
model Comment {
  id        String    @id @default(uuid())
  issueId   String
  authorId  String
  body      String    // Rich content
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  archivedAt DateTime?

  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
}

model Attachment {
  id           String   @id @default(uuid())
  issueId      String
  filename     String
  fileUrl      String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  archivedAt   DateTime?

  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  type      String   @default("SYSTEM") // "SYSTEM", "INVITATION", "ASSIGNMENT", "COMMENT", "MENTION", "ROLE_CHANGE"
  senderId  String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  archivedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(uuid())
  issueId   String
  userId    String
  action    String   // "CREATE", "UPDATE_STATUS", "ASSIGNED", etc.
  details   String   // JSON string of differences
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

// Audits & Logging
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String   // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// CSV Import Management
model ImportJob {
  id          String        @id @default(uuid())
  filename    String
  status      String        @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  progress    Int           @default(0) // Percentage 0 - 100
  totalRows   Int           @default(0)
  successRows Int           @default(0)
  failedRows  Int           @default(0)
  createdBy   String
  startedAt   DateTime?
  completedAt DateTime?
  projectId   String

  user        User          @relation(fields: [createdBy], references: [id])
  errors      ImportError[]
}

model ImportMapping {
  id              String   @id @default(uuid())
  projectId       String
  mappingTemplate String   // JSON layout mapping columns to standard schema fields
  createdBy       String
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ImportError {
  id           String    @id @default(uuid())
  jobId        String
  rowNumber    Int
  rawData      String    // JSON serialized row content
  errorMessage String
  createdAt    DateTime  @default(now())

  job          ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ============================================
// NEW FEATURES
// ============================================

// --- Time Tracking / Work Logs ---
model WorkLog {
  id          String   @id @default(uuid())
  issueId     String
  userId      String
  timeSpent   Int      // Minutes
  description String?
  loggedAt    DateTime @default(now())
  startedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

// --- Issue Watchers ---
model IssueWatcher {
  id        String   @id @default(uuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
}

// --- Saved Filters ---
model SavedFilter {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  userId      String
  filters     String   // JSON: { status, priority, type, assignee, sprint, labels, search, dueDateRange }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Release / Version Management ---
model Release {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("UNRELEASED") // "UNRELEASED", "RELEASED", "ARCHIVED"
  releaseDate DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      ReleaseIssue[]
}

model ReleaseIssue {
  id        String   @id @default(uuid())
  releaseId String
  issueId   String
  createdAt DateTime @default(now())

  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, issueId])
}

// --- Workflow Automation Rules ---
model AutomationRule {
  id             String    @id @default(uuid())
  name           String
  projectId      String
  enabled        Boolean   @default(true)
  triggerType    String    // event: issue_created, issue_updated, issue_status_changed, etc.
  triggerConfig  String?   // JSON: { fromStatusId, toStatusId, toAssigneeId, etc. }
  conditions     String?   // JSON: [{ field, operator, value }]
  conditionLogic String    @default("AND")  // "AND" | "OR"
  actions        String    // JSON: [{ type: "change_status"|"assign_user"|..., params: {} }]
  executionCount Int       @default(0)
  failureCount   Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions     AutomationExecution[]

  @@index([projectId])
  @@index([enabled])
  @@index([triggerType])
}

// --- Automation Execution Logs ---
model AutomationExecution {
  id              String    @id @default(uuid())
  ruleId          String
  status          String    // "running" | "success" | "failed"
  triggerEvent    String
  triggerPayload  String?   // JSON snapshot of context
  triggeredBy     String?
  actionsExecuted Int       @default(0)
  actionResults   String?   // JSON: [{ actionType, success, message, duration }]
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  duration        Int?

  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@index([startedAt])
}

// --- Issue Templates ---
model IssueTemplate {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  type        String   // "STORY", "TASK", "BUG", "EPIC"
  summary     String?
  description String?
  priority    String?
  labels      String?  // JSON array of label IDs
  storyPoints Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// --- Planning Poker / Estimation Sessions ---
model EstimationSession {
  id          String   @id @default(uuid())
  sprintId    String
  status      String   @default("ACTIVE") // "ACTIVE", "COMPLETED"
  currentIssueId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  votes       EstimationVote[]
}

model EstimationVote {
  id          String   @id @default(uuid())
  sessionId   String
  issueId     String
  userId      String
  value       Float?   // null = not voted yet
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     EstimationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, issueId, userId])
}
