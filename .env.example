# Project Environment Variables

# Node environment (development or production)
NODE_ENV=development

# Core API Configuration
PORT=5000
BACKEND_URL=http://localhost:5000

# Authentication Secrets
JWT_SECRET=super_secret_zyra_access_key_2026_change_me
JWT_REFRESH_SECRET=super_secret_zyra_refresh_key_2026_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_pwd_123
POSTGRES_DB=zyra
DATABASE_URL=postgresql://postgres:secure_postgres_pwd_123@postgres:5432/zyra?schema=public

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Storage Configuration
UPLOAD_DIR=/app/uploads

# Frontend direct connection configurations (No Nginx reverse proxy)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
